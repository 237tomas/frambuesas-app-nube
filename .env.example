# PostgreSQL de Supabase usado por Prisma.
# En Supabase: Project Settings -> Database -> Connection string.
# Recomendado para Vercel/serverless: usar la URL pooled/transaction pooler si está disponible.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# URL pública del proyecto Supabase.
# En Supabase: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"

# Clave secreta service_role para que el servidor pueda subir PDFs y crear signed URLs.
# En Supabase: Project Settings -> API -> service_role key.
# IMPORTANTE: no exponer en componentes cliente ni subir un .env real a GitHub.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Bucket de Supabase Storage donde se guardan los comprobantes PDF.
# Si no defines esta variable, la app usa "comprobantes" por defecto.
SUPABASE_COMPROBANTES_BUCKET="comprobantes"

# URL pública de la app. En local usa localhost; en Vercel usa tu dominio final.
# Ejemplo producción: https://frambuesas-app-nube.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
